# Require confirmation before rewriting published history.
prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease"]],
    decision = "prompt",
    justification = "Force-pushing rewrites remote history; confirm the target first.",
    match = [
        "git push --force origin main",
        "git push --force-with-lease origin main",
    ],
    not_match = [
        "git push origin main",
    ],
)

# Require confirmation before discarding tracked working-tree changes.
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "A hard reset discards uncommitted changes.",
    match = [
        "git reset --hard HEAD",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

# Never permit deleting the filesystem root.
prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Deleting the filesystem root is destructive and never needed.",
    match = [
        "rm -rf /",
    ],
    not_match = [
        "rm -rf build",
    ],
)
